# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/parapo

# JWT Secrets (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-here-change-in-production
REFRESH_SECRET_KEY=your-refresh-secret-key-here-change-in-production

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-...

# Expo Push Notifications
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,exp://localhost:8081
